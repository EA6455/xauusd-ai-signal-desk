//@version=5
// ============================================================================
//  RENDER  —  THE COMPLETE SYSTEM (all-in-one)
//
//  Five measured modules in one indicator, one panel, one chart:
//
//  · PROOF     — self-proving zones: every zone label carries its own
//                measured track record (1st/2nd/3rd+ touch bounce %),
//                base rate vs raw pivot levels, the edge, a road map
//                (next zones up/down + NEXT STOP) and dotted paths.
//  · CLOCK     — time-of-day proof: every touch scored by UTC hour;
//                best hour, worst hour, the NOW row, and a walk-forward
//                heat tint (green ≥60% · red ≤40%).
//  · SIZE      — trade planner: balance + risk % + entry + stop ->
//                exact XAUUSD lot size (standard or cent account) and
//                the desk exit plan drawn: TP1 0.75R / BE / TP2 1.5R
//                with the $ amounts. A calculator — never says buy/sell.
//  · GAUGE     — volatility meter: ATR percentile vs the last ~500
//                bars, regime QUIET / NORMAL / WILD.
//  · CONSENSUS — higher-timeframe check: zones that agree with 1H and
//                4H pivot levels get a "· 1H" / "· 4H" tag and are
//                counted in the panel. Confirmed HTF bars only.
//
//  HONESTY RULES (unchanged):
//     · a bounce counts ONLY if price travelled the target ATR in the
//       rejection direction BEFORE the zone broke — closed bars only
//     · timeouts excluded and shown as excluded; small samples flagged
//       "low n"; no fake numbers, ever
//     · no repaint: zones born from confirmed pivots, edges fixed at
//       creation, state changes on closed bars only, HTF data taken
//       from confirmed bars only (no lookahead)
//
//  · SIGNALS    — the FLOW engine inside: A+ (8/8 checks) and REV
//                reversal setups with entry, SL, TP1 0.75R / TP2 1.5R
//                drawn on chart + alert conditions. Desk-measured on
//                15m: A+ ~80% at swing 3 (~6.4/mo) · 62% at swing 2
//                (~9/mo) · REV 92% (n=13). Every signal labeled by
//                cohort — honest numbers, never fake.
//
//  Measured, not promised.
// ============================================================================
indicator("RENDER", overlay = true,
     max_boxes_count = 500, max_labels_count = 50, max_lines_count = 50)

// ---- inputs: zone detection ------------------------------------------------
grpD = "Zone detection"
kSwing   = input.int(3,     "Swing strength (bars each side) — 3 precise · 2 more boxes", minval = 2, maxval = 10, group = grpD)
impAtr   = input.float(1.8, "Impulse: min ATR multiple",  minval = 0.5, step = 0.1, group = grpD)
zoneAtr  = input.float(2.0, "Max zone height (ATR)",      minval = 0.5, step = 0.1, group = grpD)
slBuf    = input.float(0.15, "Break buffer beyond zone (ATR)", minval = 0.0, step = 0.05, group = grpD)
weakAfter = input.int(2,    "Touches before WEAK",        minval = 2, maxval = 5, group = grpD)
maxZones  = input.int(30,   "Max zones on chart (oldest removed)", minval = 5, maxval = 60, group = grpD)
maxAge    = input.int(500,  "Zone expiry (bars)",         minval = 50, maxval = 2000, group = grpD)

// ---- inputs: measurement ------------------------------------------------------
grpP = "Measurement"
bounceR   = input.float(1.0, "Bounce target (ATR) — counts as HELD", minval = 0.25, step = 0.25, group = grpP)
evalWindow = input.int(30,   "Evaluation window (bars)",  minval = 10, maxval = 100, group = grpP)
minSample  = input.int(10,   "Low-sample flag below n",   minval = 5,  maxval = 30, group = grpP)

// ---- inputs: road map -----------------------------------------------------------
grpR = "Road map"
showRoadmapRows  = input.bool(true, "Panel: road map rows (next zones + next stop)", group = grpR)
showRoadmapLines = input.bool(true, "Draw dotted paths to the next zones", group = grpR)

// ---- inputs: signals (buy / sell) ---------------------------------------------------
grpZ = "Signals (buy / sell)"
showSignals = input.bool(true, "Show A+ / REV signals — entry, SL, TP1, TP2 drawn", group = grpZ)
tp1R    = input.float(0.75, "TP1 (R) — half off", minval = 0.1, step = 0.05, group = grpZ)
tp2R    = input.float(1.5,  "TP2 (R) — runner",   minval = 0.2, step = 0.05, group = grpZ)

// ---- inputs: clock ----------------------------------------------------------------
grpK = "Clock (time of day)"
showHeat = input.bool(true, "Heat tint — shade bars by their hour's measured % (walk-forward)", group = grpK)

// ---- inputs: consensus --------------------------------------------------------------
grpC = "Consensus (higher timeframes)"
useHTF  = input.bool(true, "Tag zones that agree with 1H/4H levels", group = grpC)
htf1Tf  = input.timeframe("60",  "Higher timeframe 1", group = grpC)
htf2Tf  = input.timeframe("240", "Higher timeframe 2", group = grpC)
htfTol  = input.float(0.5, "Agreement tolerance (ATR)", minval = 0.1, step = 0.1, group = grpC)

// ---- inputs: size (trade planner) ------------------------------------------------------
grpS = "Size (trade planner)"
sizeOn   = input.bool(false, "Show trade planner — set your trade below", group = grpS)
balIn    = input.float(1000, "Account balance ($)", minval = 1, group = grpS)
riskPct  = input.float(1.0,  "Risk per trade (%)", minval = 0.1, step = 0.1, group = grpS)
centAcct = input.bool(false, "Cent account (lots x100)", group = grpS)
sizeDir  = input.string("Long", "Direction", options = ["Long", "Short"], group = grpS)
sizeEntry = input.float(0.0, "Entry price (0 = live price)", minval = 0, step = 0.01, group = grpS)
sizeStop  = input.float(0.0, "Stop price", minval = 0, step = 0.01, group = grpS)

// ---- inputs: gauge ------------------------------------------------------------------------
grpG = "Gauge (volatility)"
gaugeOn  = input.bool(true, "Show volatility readout", group = grpG)

// ---- inputs: display ---------------------------------------------------------------------------
grpV = "Display"
showTable  = input.bool(true, "Show panel", group = grpV)
posOpt = input.string("Top Right", "Panel position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpV)
showDemand = input.bool(true, "Show demand zones (green)", group = grpV)
showSupply = input.bool(true, "Show supply zones (red)",   group = grpV)
extendBars = input.int(6,     "Extend boxes right (bars)", minval = 0, maxval = 40, group = grpV)
bullColor  = input.color(color.green, "Demand color", group = grpV)
bearColor  = input.color(color.red,   "Supply color", group = grpV)

// ---- basics --------------------------------------------------------------------------------------
atr = ta.atr(14)
hrU = hour(time, "UTC")
sessDead = hrU >= 21 or hrU < 1

// 1H trend from COMPLETED hourly bars (non-repainting request pattern)
[hE9, hE21, hC] = request.security(syminfo.tickerid, "60",
     [ta.ema(close, 9)[1], ta.ema(close, 21)[1], close[1]],
     lookahead = barmerge.lookahead_on)
var int hourBars = 0
if ta.change(time("60")) != 0
    hourBars += 1
htf = hourBars < 25 ? 0 : hE9 > hE21 and hC > hE21 ? 1 : hE9 < hE21 and hC < hE21 ? -1 : 0

// confirmation candle: engulfing or pin in the rejection direction
f_confirm(d) =>
    ok = false
    if bar_index >= 1
        body = math.abs(close - open)
        rng = high - low
        if rng > 0
            if d == 1
                eng = close > open and open <= close[1] and close >= open[1] and close > close[1] and body > math.abs(close[1] - open[1])
                pin = (math.min(open, close) - low) >= 1.8 * body and close >= low + 0.6 * rng
                ok := eng or pin
            else
                eng = close < open and open >= close[1] and close <= open[1] and close < close[1] and body > math.abs(close[1] - open[1])
                pin = (high - math.max(open, close)) >= 1.8 * body and close <= high - 0.6 * rng
                ok := eng or pin
    ok

// ---- stats (all measured on this chart, closed bars only) ------------------------------------------
var statsW = array.from(0, 0, 0)     // cohort: 0=1st touch, 1=2nd, 2=3rd+
var statsN = array.from(0, 0, 0)
var hw = array.new_int(24, 0)        // per-UTC-hour zone outcomes
var hn = array.new_int(24, 0)
var rw = array.new_int(6, 0)         // raw pivot base rate, per 4h block
var rn = array.new_int(6, 0)
var int exclN = 0

f_pct(w, n) =>
    n > 0 ? str.tostring(100.0 * w / n, "#") + "%" : "—"

f_lowN(n) =>
    n > 0 and n < minSample ? " · low n" : ""

f_resolve(tN, isWin, tHour) =>
    ci = tN == 1 ? 0 : tN == 2 ? 1 : 2
    array.set(statsN, ci, array.get(statsN, ci) + 1)
    if isWin
        array.set(statsW, ci, array.get(statsW, ci) + 1)
    array.set(hn, tHour, array.get(hn, tHour) + 1)
    if isWin
        array.set(hw, tHour, array.get(hw, tHour) + 1)

// ---- swings ------------------------------------------------------------------------------------------
ph = ta.pivothigh(high, kSwing, kSwing)
pl = ta.pivotlow(low,  kSwing, kSwing)

var loIdx = array.new_int(0)
var loVal = array.new_float(0)
var loAtr = array.new_float(0)
var loTop = array.new_float(0)
var loBot = array.new_float(0)
var loPriorHi = array.new_float(0)
var hiIdx = array.new_int(0)
var hiVal = array.new_float(0)
var hiAtr = array.new_float(0)
var hiTop = array.new_float(0)
var hiBot = array.new_float(0)
var hiPriorLo = array.new_float(0)

// structure trackers (for the A+ checks)
var int   h1i = -1
var float h1v = na
var int   h2i = -1
var float h2v = na
var int   l1i = -1
var float l1v = na
var int   l2i = -1
var float l2v = na
var int   structNow = 0
var bool  bosNow = false

// raw pivot levels for the base rate
var bIdx   = array.new_int(0)
var bLvl   = array.new_float(0)
var bDir   = array.new_int(0)
var bBirth = array.new_int(0)
var bBlk   = array.new_int(0)

// live zones
var zTop = array.new_float(0)
var zBot = array.new_float(0)
var zSide = array.new_int(0)
var zTouches = array.new_int(0)
var zCreated = array.new_int(0)
var zLeft = array.new_int(0)
var zIn = array.new_int(0)
var eBirth = array.new_int(0)
var eTarget = array.new_float(0)
var eBreak = array.new_float(0)
var eTHour = array.new_int(0)
var zBox = array.new_box(0)
var zSignaled = array.new_bool(0)
var zTested = array.new_bool(0)
var zFTBar = array.new_int(0)
var zCaused = array.new_bool(0)

// signal drawings + counters + per-bar alert flags
var tEntry = array.new_line(0)
var tSL = array.new_line(0)
var tTP1 = array.new_line(0)
var tTP2 = array.new_line(0)
var tPBox = array.new_box(0)
var tRBox = array.new_box(0)
var sigLbls = array.new_label(0)
var int sigAPlus = 0
var int sigRevN = 0
bool aPlusBuy = false
bool aPlusSell = false
bool revBuy = false
bool revSell = false

// ---- consensus: confirmed HTF pivot levels (no lookahead) ----------------------------------------------
ph1 = request.security(syminfo.tickerid, htf1Tf, ta.pivothigh(high, 3, 3)[1])
pl1 = request.security(syminfo.tickerid, htf1Tf, ta.pivotlow(low, 3, 3)[1])
ph2 = request.security(syminfo.tickerid, htf2Tf, ta.pivothigh(high, 3, 3)[1])
pl2 = request.security(syminfo.tickerid, htf2Tf, ta.pivotlow(low, 3, 3)[1])

var htfHi1 = array.new_float(0)
var htfLo1 = array.new_float(0)
var htfHi2 = array.new_float(0)
var htfLo2 = array.new_float(0)

f_collect(arr, v) =>
    // NOTE: Pine evaluates BOTH sides of 'and'/'or'/'?' — the size check
    // and the array read must be separate statements, never one expression
    if not na(v)
        bool sameAsLast = false
        if array.size(arr) > 0
            sameAsLast := math.abs(array.get(arr, array.size(arr) - 1) - v) <= syminfo.mintick
        if not sameAsLast
            array.push(arr, v)
            if array.size(arr) > 8
                array.remove(arr, 0)

f_htfAgree(arr, zt, zb) =>
    bool a = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            if lv >= zb - htfTol * atr and lv <= zt + htfTol * atr
                a := true
                break
    a

f_htfTag(zt, zb) =>
    string t = ""
    if useHTF
        bool a1 = f_htfAgree(htfHi1, zt, zb) or f_htfAgree(htfLo1, zt, zb)
        bool a2 = f_htfAgree(htfHi2, zt, zb) or f_htfAgree(htfLo2, zt, zb)
        if a1
            t += " · 1H"
        if a2
            t += " · 4H"
    t

f_makeZone(sIdx, sTop, sBot, side, caused) =>
    if array.size(zTop) >= maxZones
        box.delete(array.get(zBox, 0))
        array.remove(zTop, 0)
        array.remove(zBot, 0)
        array.remove(zSide, 0)
        array.remove(zTouches, 0)
        array.remove(zCreated, 0)
        array.remove(zLeft, 0)
        array.remove(zIn, 0)
        array.remove(eBirth, 0)
        array.remove(eTarget, 0)
        array.remove(eBreak, 0)
        array.remove(eTHour, 0)
        array.remove(zBox, 0)
        array.remove(zSignaled, 0)
        array.remove(zTested, 0)
        array.remove(zFTBar, 0)
        array.remove(zCaused, 0)
    zc = side == 1 ? bullColor : bearColor
    sideVis = side == 1 ? showDemand : showSupply
    txt = "FRESH"
    if array.get(statsN, 0) > 0
        txt := "FRESH · 1st bounce " + f_pct(array.get(statsW, 0), array.get(statsN, 0)) +
             " (n=" + str.tostring(array.get(statsN, 0)) + ")" + f_lowN(array.get(statsN, 0))
    txt += f_htfTag(sTop, sBot)
    array.push(zTop, sTop)
    array.push(zBot, sBot)
    array.push(zSide, side)
    array.push(zTouches, 0)
    array.push(zCreated, bar_index)
    array.push(zLeft, sIdx)
    array.push(zIn, 0)
    array.push(eBirth, -1)
    array.push(eTarget, 0.0)
    array.push(eBreak, 0.0)
    array.push(eTHour, 0)
    array.push(zSignaled, false)
    array.push(zTested, false)
    array.push(zFTBar, 0)
    array.push(zCaused, caused)
    bx = sideVis ? box.new(sIdx, sTop, bar_index + extendBars, sBot, border_color = color.new(zc, 30), bgcolor = color.new(zc, 82), border_width = 1, text = txt, text_color = color.new(zc, 5), text_size = size.tiny) : box(na)
    array.push(zBox, bx)

// ---- pivot processing -------------------------------------------------------------------------------------
if not na(ph) and bar_index > kSwing + 2
    pi = bar_index - kSwing
    h2i := h1i
    h2v := h1v
    h1i := pi
    h1v := ph
    bTop = math.max(high[kSwing], math.max(high[kSwing + 1], high[kSwing + 2]))
    bBot = math.min(low[kSwing],  math.min(low[kSwing + 1],  low[kSwing + 2]))
    array.push(hiIdx, pi)
    array.push(hiVal, ph)
    array.push(hiAtr, atr[kSwing])
    array.push(hiTop, bTop)
    array.push(hiBot, bBot)
    array.push(hiPriorLo, l1v)
    array.push(bIdx, pi)
    array.push(bLvl, ph)
    array.push(bDir, -1)
    array.push(bBirth, bar_index)
    array.push(bBlk, int(math.floor(hrU / 4.0)))
    if array.size(loIdx) > 0
        for i = array.size(loIdx) - 1 to 0
            sIdx = array.get(loIdx, i)
            sVal = array.get(loVal, i)
            sAtr = array.get(loAtr, i)
            sTop = array.get(loTop, i)
            sBot = array.get(loBot, i)
            impulse = ph - sVal
            sPriorHi = array.get(loPriorHi, i)
            caused = not na(sPriorHi) ? ph > sPriorHi : false
            if pi - sIdx <= 48 and impulse >= impAtr * sAtr and sTop > sBot and sTop - sBot <= zoneAtr * sAtr
                dup = false
                if array.size(zTop) > 0
                    for zi = 0 to array.size(zTop) - 1
                        if array.get(zSide, zi) == 1 and bar_index - array.get(zCreated, zi) <= 24 and not (sBot > array.get(zTop, zi) or sTop < array.get(zBot, zi))
                            dup := true
                            break
                if not dup
                    f_makeZone(sIdx, sTop, sBot, 1, caused)
            array.remove(loIdx, i)
            array.remove(loVal, i)
            array.remove(loAtr, i)
            array.remove(loTop, i)
            array.remove(loBot, i)
            array.remove(loPriorHi, i)

if not na(pl) and bar_index > kSwing + 2
    pi = bar_index - kSwing
    l2i := l1i
    l2v := l1v
    l1i := pi
    l1v := pl
    bTop = math.max(high[kSwing], math.max(high[kSwing + 1], high[kSwing + 2]))
    bBot = math.min(low[kSwing],  math.min(low[kSwing + 1],  low[kSwing + 2]))
    array.push(loIdx, pi)
    array.push(loVal, pl)
    array.push(loAtr, atr[kSwing])
    array.push(loTop, bTop)
    array.push(loBot, bBot)
    array.push(loPriorHi, h1v)
    array.push(bIdx, pi)
    array.push(bLvl, pl)
    array.push(bDir, 1)
    array.push(bBirth, bar_index)
    array.push(bBlk, int(math.floor(hrU / 4.0)))
    if array.size(hiIdx) > 0
        for i = array.size(hiIdx) - 1 to 0
            sIdx = array.get(hiIdx, i)
            sVal = array.get(hiVal, i)
            sAtr = array.get(hiAtr, i)
            sTop = array.get(hiTop, i)
            sBot = array.get(hiBot, i)
            impulse = sVal - pl
            sPriorLo = array.get(hiPriorLo, i)
            caused = not na(sPriorLo) ? pl < sPriorLo : false
            if pi - sIdx <= 48 and impulse >= impAtr * sAtr and sTop > sBot and sTop - sBot <= zoneAtr * sAtr
                dup = false
                if array.size(zTop) > 0
                    for zi = 0 to array.size(zTop) - 1
                        if array.get(zSide, zi) == -1 and bar_index - array.get(zCreated, zi) <= 24 and not (sBot > array.get(zTop, zi) or sTop < array.get(zBot, zi))
                            dup := true
                            break
                if not dup
                    f_makeZone(sIdx, sTop, sBot, -1, caused)
            array.remove(hiIdx, i)
            array.remove(hiVal, i)
            array.remove(hiAtr, i)
            array.remove(hiTop, i)
            array.remove(hiBot, i)
            array.remove(hiPriorLo, i)

// ---- structure state after updates --------------------------------------------------------------
if h1i >= 0 and h2i >= 0 and l1i >= 0 and l2i >= 0
    hh = h1v > h2v
    hl = l1v > l2v
    lh = h1v < h2v
    ll = l1v < l2v
    structNow := hh and hl ? 1 : lh and ll ? -1 : 0
    bosNow := structNow == 1 ? (bar_index - h1i) <= 40 : structNow == -1 ? (bar_index - l1i) <= 40 : false

// ---- consensus level collection (runs every bar; values are confirmed-only) ---------------------------------
f_collect(htfHi1, ph1)
f_collect(htfLo1, pl1)
f_collect(htfHi2, ph2)
f_collect(htfLo2, pl2)

// ---- RENDER engine — CLOSED BARS ONLY (strict no-repaint) ------------------------------------------------------
if barstate.isconfirmed
    // 1) continue open zone evaluations
    if array.size(zTop) > 0
        for zi = 0 to array.size(zTop) - 1
            eb = array.get(eBirth, zi)
            if eb >= 0 and bar_index > eb
                s = array.get(zSide, zi)
                res = false
                isWin = false
                if s == 1
                    if low <= array.get(eBreak, zi)
                        res := true
                    else if high >= array.get(eTarget, zi)
                        res := true
                        isWin := true
                else
                    if high >= array.get(eBreak, zi)
                        res := true
                    else if low <= array.get(eTarget, zi)
                        res := true
                        isWin := true
                if not res and bar_index - eb > evalWindow
                    exclN += 1
                    res := true
                if res
                    f_resolve(array.get(zTouches, zi), isWin, array.get(eTHour, zi))
                    array.set(eBirth, zi, -1)

    // 2) raw pivot-level base rate, per 4-hour block
    if array.size(bIdx) > 0
        for i = array.size(bIdx) - 1 to 0
            bdir = array.get(bDir, i)
            lvl = array.get(bLvl, i)
            born = array.get(bBirth, i)
            if bar_index > born
                oc = 0
                if bdir == 1
                    if low < lvl - slBuf * atr
                        oc := 2
                    else if high >= lvl + bounceR * atr
                        oc := 1
                else
                    if high > lvl + slBuf * atr
                        oc := 2
                    else if low <= lvl - bounceR * atr
                        oc := 1
                if oc == 0 and bar_index - born > evalWindow
                    oc := 3
                if oc == 1 or oc == 2
                    bb = array.get(bBlk, i)
                    array.set(rn, bb, array.get(rn, bb) + 1)
                    if oc == 1
                        array.set(rw, bb, array.get(rw, bb) + 1)
                else if oc == 3
                    exclN += 1
                if oc != 0
                    array.remove(bIdx, i)
                    array.remove(bLvl, i)
                    array.remove(bDir, i)
                    array.remove(bBirth, i)
                    array.remove(bBlk, i)
        if array.size(bIdx) > 200
            for i = 0 to array.size(bIdx) - 201
                array.remove(bIdx, 0)
                array.remove(bLvl, 0)
                array.remove(bDir, 0)
                array.remove(bBirth, 0)
                array.remove(bBlk, 0)

    // 3) touch detection + state labels + evaluation start
    if array.size(zTop) > 0
        for zi = 0 to array.size(zTop) - 1
            s = array.get(zSide, zi)
            zt = array.get(zTop, zi)
            zb = array.get(zBot, zi)
            if not na(array.get(zBox, zi))
                box.set_right(array.get(zBox, zi), bar_index + extendBars)
            touching = s == 1 ? (low <= zt and close >= zb) : (high >= zb and close <= zt)
            if touching and array.get(zIn, zi) == 0
                tN = array.get(zTouches, zi) + 1
                array.set(zTouches, zi, tN)
                firstTouch = not array.get(zTested, zi)
                if firstTouch
                    array.set(zTested, zi, true)
                    array.set(zFTBar, zi, bar_index)
                brokenNow = s == 1 ? low < zb - slBuf * atr : high > zt + slBuf * atr
                if not brokenNow
                    array.set(eBirth, zi, bar_index)
                    array.set(eTarget, zi, s == 1 ? zt + bounceR * atr : zb - bounceR * atr)
                    array.set(eBreak, zi, s == 1 ? zb - slBuf * atr : zt + slBuf * atr)
                    array.set(eTHour, zi, hrU)
                // ---- SIGNALS: the A+/REV checks (FLOW engine, closed bars only)
                inWindow = bar_index - array.get(zFTBar, zi) <= 6
                d = s
                c1 = structNow == d
                c2 = bosNow
                c3 = array.get(zCaused, zi)
                c4 = firstTouch
                c5 = true
                c6 = f_confirm(d)
                c7 = htf == d
                c8 = not sessDead
                passed = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0)
                isRev = c2 and c3 and c4 and c8 and not c1 and not c7
                if showSignals and inWindow and not array.get(zSignaled, zi) and c6 and (passed >= 8 or isRev)
                    array.set(zSignaled, zi, true)
                    grade = passed >= 8 ? "A+" : "REV"
                    entryP = close
                    slP = d == 1 ? zb - slBuf * atr : zt + slBuf * atr
                    riskP = math.abs(entryP - slP)
                    tp1P = entryP + d * tp1R * riskP
                    tp2P = entryP + d * tp2R * riskP
                    col = grade == "REV" ? color.new(color.rgb(20, 184, 166), 5) : d == 1 ? color.new(color.green, 10) : color.new(color.red, 10)
                    txt = (d == 1 ? "▲ LONG" : "▼ SHORT") + " · " + grade + "\nE " + str.tostring(entryP, "#.##") + "\nSL " + str.tostring(slP, "#.##") + "\nTP1 " + str.tostring(tp1P, "#.##") + "\nTP2 " + str.tostring(tp2P, "#.##")
                    if array.size(tEntry) >= 12
                        line.delete(array.get(tEntry, 0))
                        line.delete(array.get(tSL, 0))
                        line.delete(array.get(tTP1, 0))
                        line.delete(array.get(tTP2, 0))
                        box.delete(array.get(tPBox, 0))
                        box.delete(array.get(tRBox, 0))
                        array.remove(tEntry, 0)
                        array.remove(tSL, 0)
                        array.remove(tTP1, 0)
                        array.remove(tTP2, 0)
                        array.remove(tPBox, 0)
                        array.remove(tRBox, 0)
                    ext = bar_index + 34
                    array.push(tEntry, line.new(bar_index, entryP, ext, entryP, color = color.new(color.blue, 0), width = 2))
                    array.push(tSL, line.new(bar_index, slP, ext, slP, color = color.new(color.red, 0), width = 2, style = line.style_dashed))
                    array.push(tTP1, line.new(bar_index, tp1P, ext, tp1P, color = color.new(color.green, 35), width = 1))
                    array.push(tTP2, line.new(bar_index, tp2P, ext, tp2P, color = color.new(color.green, 0), width = 2))
                    array.push(tPBox, box.new(bar_index, math.max(entryP, tp2P), ext, math.min(entryP, tp2P), bgcolor = color.new(color.green, 84), border_color = color.new(color.green, 45)))
                    array.push(tRBox, box.new(bar_index, math.max(entryP, slP), ext, math.min(entryP, slP), bgcolor = color.new(color.red, 82), border_color = color.new(color.red, 50)))
                    array.push(sigLbls, label.new(bar_index, d == 1 ? low : high, txt, style = d == 1 ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small))
                    if array.size(sigLbls) > 40
                        label.delete(array.get(sigLbls, 0))
                        array.remove(sigLbls, 0)
                    if grade == "A+"
                        sigAPlus += 1
                        if d == 1
                            aPlusBuy := true
                        else
                            aPlusSell := true
                    if grade == "REV"
                        sigRevN += 1
                        if d == 1
                            revBuy := true
                        else
                            revSell := true
                // state label carries the NEXT-touch cohort stats
                isWeak = tN >= weakAfter
                sideVis = s == 1 ? showDemand : showSupply
                nxi = tN == 1 ? 1 : 2
                nN = array.get(statsN, nxi)
                nW = array.get(statsW, nxi)
                txt = (isWeak ? "WEAK (" + str.tostring(tN) + ")" : "TESTED (" + str.tostring(tN) + ")") +
                     " · next " + f_pct(nW, nN) + " (n=" + str.tostring(nN) + ")" + f_lowN(nN)
                if isWeak
                    txt += " · break map"
                txt += f_htfTag(zt, zb)
                bxh = array.get(zBox, zi)
                zc = s == 1 ? bullColor : bearColor
                if sideVis
                    if na(bxh)
                        array.set(zBox, zi, box.new(array.get(zLeft, zi), zt, bar_index + extendBars, zb, border_color = isWeak ? color.new(color.gray, 45) : color.new(zc, 35), bgcolor = isWeak ? color.new(zc, 95) : color.new(zc, 92), border_width = 1, border_style = isWeak ? line.style_solid : line.style_dashed, text = txt, text_color = isWeak ? color.new(color.gray, 15) : color.new(zc, 25), text_size = size.tiny))
                    else
                        box.set_text(bxh, txt)
                        box.set_text_color(bxh, isWeak ? color.new(color.gray, 15) : color.new(zc, 25))
                        box.set_border_style(bxh, line.style_dashed)
                        if isWeak
                            box.set_border_color(bxh, color.new(color.gray, 45))
                            box.set_bgcolor(bxh, color.new(zc, 95))
                        else
                            box.set_bgcolor(bxh, color.new(zc, 92))
            array.set(zIn, zi, touching ? 1 : 0)

    // 4) break / age deletion
    if array.size(zTop) > 0
        for zi = array.size(zTop) - 1 to 0
            s = array.get(zSide, zi)
            zt = array.get(zTop, zi)
            zb = array.get(zBot, zi)
            old = bar_index - array.get(zCreated, zi)
            broken = s == 1 ? low < zb - slBuf * atr : high > zt + slBuf * atr
            if broken or old > maxAge
                if array.get(eBirth, zi) >= 0
                    exclN += 1
                box.delete(array.get(zBox, zi))
                array.remove(zTop, zi)
                array.remove(zBot, zi)
                array.remove(zSide, zi)
                array.remove(zTouches, zi)
                array.remove(zCreated, zi)
                array.remove(zLeft, zi)
                array.remove(zIn, zi)
                array.remove(eBirth, zi)
                array.remove(eTarget, zi)
                array.remove(eBreak, zi)
                array.remove(eTHour, zi)
                array.remove(zBox, zi)
                array.remove(zSignaled, zi)
                array.remove(zTested, zi)
                array.remove(zFTBar, zi)
                array.remove(zCaused, zi)

// ---- clock heat tint — walk-forward -------------------------------------------------------------------------
f_heatColor() =>
    color c = na
    n = array.get(hn, hrU)
    if n >= minSample
        pct = 100.0 * array.get(hw, hrU) / n
        if pct >= 60
            c := color.new(color.green, 88)
        else if pct <= 40
            c := color.new(color.red, 88)
        else
            c := color.new(color.gray, 94)
    c
bgcolor(showHeat and barstate.isconfirmed ? f_heatColor() : na)

// ---- pruning of unpaired pivots --------------------------------------------------------------------------------
if array.size(loIdx) > 0
    for i = array.size(loIdx) - 1 to 0
        if bar_index - array.get(loIdx, i) > 200
            array.remove(loIdx, i)
            array.remove(loVal, i)
            array.remove(loAtr, i)
            array.remove(loTop, i)
            array.remove(loBot, i)
            array.remove(loPriorHi, i)
if array.size(hiIdx) > 0
    for i = array.size(hiIdx) - 1 to 0
        if bar_index - array.get(hiIdx, i) > 200
            array.remove(hiIdx, i)
            array.remove(hiVal, i)
            array.remove(hiAtr, i)
            array.remove(hiTop, i)
            array.remove(hiBot, i)
            array.remove(hiPriorLo, i)

// ---- plots: signal markers -------------------------------------------------------
plotshape(aPlusBuy,  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small, title = "A+ LONG")
plotshape(aPlusSell, style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.small, title = "A+ SHORT")
plotshape(revBuy,    style = shape.diamond,      location = location.belowbar, color = color.new(color.rgb(20, 184, 166), 0), size = size.tiny, title = "REV LONG")
plotshape(revSell,   style = shape.diamond,      location = location.abovebar, color = color.new(color.rgb(20, 184, 166), 0), size = size.tiny, title = "REV SHORT")

// ---- alert conditions -------------------------------------------------------------
alertcondition(aPlusBuy,  "A+ LONG setup",  "RENDER: A+ LONG setup confirmed — entry, SL and TPs drawn on chart")
alertcondition(aPlusSell, "A+ SHORT setup", "RENDER: A+ SHORT setup confirmed — entry, SL and TPs drawn on chart")
alertcondition(revBuy,    "REV LONG setup",  "RENDER: REV reversal LONG confirmed — entry, SL and TPs drawn on chart")
alertcondition(revSell,   "REV SHORT setup", "RENDER: REV reversal SHORT confirmed — entry, SL and TPs drawn on chart")

// ---- gauge (volatility) — ATR percentile vs last 500 bars --------------------------------------------------------
atrPct = ta.percentrank(atr, 500)
string volRegime = na(atrPct) ? "—" : atrPct < 30 ? "QUIET" : atrPct > 70 ? "WILD" : "NORMAL"

// ---- road map + panel — last bar only (overwrite-only, no merges/clears) --------------------------------------------
// NOTE: Pine evaluates BOTH sides of 'and' and '?:' — array reads are
// precomputed inside index guards, never inline (no 'Index -1' crashes)
f_zoneStat(tN) =>
    idx = tN == 0 ? 0 : tN == 1 ? 1 : 2
    f_pct(array.get(statsW, idx), array.get(statsN, idx))

f_zoneLabel(zi) =>
    tN = array.get(zTouches, zi)
    st = tN == 0 ? "FRESH" : tN >= weakAfter ? "WEAK (" + str.tostring(tN) + ")" : "TESTED (" + str.tostring(tN) + ")"
    st + " · " + f_zoneStat(tN)

var line upLine = na
var line dnLine = na
var label upLab = na
var label dnLab = na

// SIZE drawings
var line eLine = na
var line sLine = na
var line t1Line = na
var line t2Line = na
var label eLab = na
var label sLab = na
var label t1Lab = na
var label t2Lab = na

var table tb = na

if barstate.islast
    // ---- road map: nearest live zone above and below
    float upLvl = na
    int upZi = -1
    float dnLvl = na
    int dnZi = -1
    if array.size(zTop) > 0
        for zi = 0 to array.size(zTop) - 1
            zb = array.get(zBot, zi)
            zt = array.get(zTop, zi)
            if zb >= close and (upZi < 0 or zb < upLvl)
                upLvl := zb
                upZi := zi
            if zt <= close and (dnZi < 0 or zt > dnLvl)
                dnLvl := zt
                dnZi := zi
    bool upFresh = false
    if upZi >= 0
        upFresh := array.get(zTouches, upZi) == 0
    bool dnFresh = false
    if dnZi >= 0
        dnFresh := array.get(zTouches, dnZi) == 0
    bool nsUp = false
    int nsZi = -1
    float nsLvl = na
    if upFresh
        nsUp := true
        nsLvl := upLvl
        nsZi := upZi
    else if dnFresh
        nsLvl := dnLvl
        nsZi := dnZi
    else if upZi >= 0 and dnZi >= 0
        if upLvl - close <= close - dnLvl
            nsUp := true
            nsLvl := upLvl
            nsZi := upZi
        else
            nsLvl := dnLvl
            nsZi := dnZi
    else if upZi >= 0
        nsUp := true
        nsLvl := upLvl
        nsZi := upZi
    else if dnZi >= 0
        nsLvl := dnLvl
        nsZi := dnZi
    // dotted paths to the next zones
    if showRoadmapLines
        if upZi >= 0
            labU = "↑ " + str.tostring(upLvl, format.mintick) + " · " + f_zoneLabel(upZi)
            if na(upLine)
                upLine := line.new(bar_index - 2, close, bar_index + 10, upLvl, color = color.new(bearColor, 35), style = line.style_dotted, width = 1)
            else
                line.set_xy1(upLine, bar_index - 2, close)
                line.set_xy2(upLine, bar_index + 10, upLvl)
            if na(upLab)
                upLab := label.new(bar_index + 10, upLvl, labU, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(bearColor, 10), size = size.tiny)
            else
                label.set_xy(upLab, bar_index + 10, upLvl)
                label.set_text(upLab, labU)
        else
            line.delete(upLine)
            upLine := line(na)
            label.delete(upLab)
            upLab := label(na)
        if dnZi >= 0
            labD = "↓ " + str.tostring(dnLvl, format.mintick) + " · " + f_zoneLabel(dnZi)
            if na(dnLine)
                dnLine := line.new(bar_index - 2, close, bar_index + 10, dnLvl, color = color.new(bullColor, 35), style = line.style_dotted, width = 1)
            else
                line.set_xy1(dnLine, bar_index - 2, close)
                line.set_xy2(dnLine, bar_index + 10, dnLvl)
            if na(dnLab)
                dnLab := label.new(bar_index + 10, dnLvl, labD, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(bullColor, 10), size = size.tiny)
            else
                label.set_xy(dnLab, bar_index + 10, dnLvl)
                label.set_text(dnLab, labD)
        else
            line.delete(dnLine)
            dnLine := line(na)
            label.delete(dnLab)
            dnLab := label(na)

    // ---- SIZE: trade planner (calculator — never says buy/sell)
    float szLots = na
    float szRisk = na
    float szTp1 = na
    float szTp2 = na
    string szMsg = ""
    if sizeOn
        float ent = sizeEntry > 0 ? sizeEntry : close
        float stp = sizeStop
        szRisk := balIn * riskPct / 100.0
        bool sideOk = sizeDir == "Long" ? stp < ent : stp > ent
        if stp <= 0
            szMsg := "set entry + stop in settings"
        else if not sideOk
            szMsg := "stop is on the wrong side for " + sizeDir
        else
            float dist = math.abs(ent - stp)
            szLots := szRisk / (dist * 100.0)
            if centAcct
                szLots := szLots * 100.0
            szTp1 := sizeDir == "Long" ? ent + 0.75 * dist : ent - 0.75 * dist
            szTp2 := sizeDir == "Long" ? ent + 1.5 * dist : ent - 1.5 * dist
            // plan drawings
            if na(eLine)
                eLine := line.new(bar_index - 5, ent, bar_index + 12, ent, color = color.new(color.blue, 20), width = 1)
                sLine := line.new(bar_index - 5, stp, bar_index + 12, stp, color = color.new(color.red, 20), width = 1)
                t1Line := line.new(bar_index - 5, szTp1, bar_index + 12, szTp1, color = color.new(color.green, 30), style = line.style_dashed, width = 1)
                t2Line := line.new(bar_index - 5, szTp2, bar_index + 12, szTp2, color = color.new(color.green, 15), style = line.style_dashed, width = 1)
                eLab := label.new(bar_index + 12, ent, "ENTRY · " + str.tostring(szLots, "#.##") + " lots", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.blue, 10), size = size.tiny)
                sLab := label.new(bar_index + 12, stp, "SL · risk $" + str.tostring(szRisk, "#.#"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.red, 10), size = size.tiny)
                t1Lab := label.new(bar_index + 12, szTp1, "TP1 0.75R · half +$" + str.tostring(0.75 * szRisk * 0.5, "#.#"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.green, 10), size = size.tiny)
                t2Lab := label.new(bar_index + 12, szTp2, "TP2 1.5R · runner +$" + str.tostring(1.5 * szRisk * 0.5, "#.#"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.green, 10), size = size.tiny)
            else
                line.set_xy1(eLine, bar_index - 5, ent)
                line.set_xy2(eLine, bar_index + 12, ent)
                line.set_xy1(sLine, bar_index - 5, stp)
                line.set_xy2(sLine, bar_index + 12, stp)
                line.set_xy1(t1Line, bar_index - 5, szTp1)
                line.set_xy2(t1Line, bar_index + 12, szTp1)
                line.set_xy1(t2Line, bar_index - 5, szTp2)
                line.set_xy2(t2Line, bar_index + 12, szTp2)
                label.set_xy(eLab, bar_index + 12, ent)
                label.set_text(eLab, "ENTRY · " + str.tostring(szLots, "#.##") + " lots")
                label.set_xy(sLab, bar_index + 12, stp)
                label.set_text(sLab, "SL · risk $" + str.tostring(szRisk, "#.#"))
                label.set_xy(t1Lab, bar_index + 12, szTp1)
                label.set_text(t1Lab, "TP1 0.75R · half +$" + str.tostring(0.75 * szRisk * 0.5, "#.#"))
                label.set_xy(t2Lab, bar_index + 12, szTp2)
                label.set_text(t2Lab, "TP2 1.5R · runner +$" + str.tostring(1.5 * szRisk * 0.5, "#.#"))
    if not sizeOn
        line.delete(eLine)
        line.delete(sLine)
        line.delete(t1Line)
        line.delete(t2Line)
        label.delete(eLab)
        label.delete(sLab)
        label.delete(t1Lab)
        label.delete(t2Lab)
        eLine := line(na)
        sLine := line(na)
        t1Line := line(na)
        t2Line := line(na)
        eLab := label(na)
        sLab := label(na)
        t1Lab := label(na)
        t2Lab := label(na)

    // ---- consensus counts
    int agree1 = 0
    int agree4 = 0
    if useHTF and array.size(zTop) > 0
        for zi = 0 to array.size(zTop) - 1
            zt = array.get(zTop, zi)
            zb = array.get(zBot, zi)
            if f_htfAgree(htfHi1, zt, zb) or f_htfAgree(htfLo1, zt, zb)
                agree1 += 1
            if f_htfAgree(htfHi2, zt, zb) or f_htfAgree(htfLo2, zt, zb)
                agree4 += 1

    // ---- panel
    if showTable
        if na(tb)
            posMap = posOpt == "Top Right" ? position.top_right : posOpt == "Top Left" ? position.top_left : posOpt == "Bottom Right" ? position.bottom_right : position.bottom_left
            tb := table.new(posMap, 3, 19, bgcolor = color.new(#0a0e17, 15), border_width = 1, border_color = color.new(color.gray, 72))
        hdr = color.new(color.gray, 62)
        table.cell(tb, 0, 0, "RENDER", text_color = color.new(color.white, 8), text_size = size.small, bgcolor = hdr)
        table.cell(tb, 1, 0, "zones · time · size · vol", text_color = color.new(color.white, 8), text_size = size.small, bgcolor = hdr)
        table.cell(tb, 2, 0, "this chart's own history", text_color = color.new(color.white, 8), text_size = size.small, bgcolor = hdr)
        table.cell(tb, 0, 1, "1st touch (FRESH)", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 1, f_pct(array.get(statsW, 0), array.get(statsN, 0)), text_color = color.new(color.green, 10), text_size = size.tiny)
        table.cell(tb, 2, 1, "n=" + str.tostring(array.get(statsN, 0)) + f_lowN(array.get(statsN, 0)), text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 2, "2nd touch", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 2, f_pct(array.get(statsW, 1), array.get(statsN, 1)), text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 2, "n=" + str.tostring(array.get(statsN, 1)), text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 3, "3rd+ touch", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 3, f_pct(array.get(statsW, 2), array.get(statsN, 2)), text_color = color.new(color.gray, 15), text_size = size.tiny)
        table.cell(tb, 2, 3, "n=" + str.tostring(array.get(statsN, 2)), text_color = color.new(color.gray, 30), text_size = size.tiny)
        int trw2 = 0
        int trn2 = 0
        for b = 0 to 5
            trw2 += array.get(rw, b)
            trn2 += array.get(rn, b)
        table.cell(tb, 0, 4, "raw pivot levels", text_color = color.new(color.gray, 20), text_size = size.tiny)
        table.cell(tb, 1, 4, f_pct(trw2, trn2), text_color = color.new(color.gray, 10), text_size = size.tiny)
        table.cell(tb, 2, 4, "n=" + str.tostring(trn2), text_color = color.new(color.gray, 30), text_size = size.tiny)
        edgeTxt = "—"
        if array.get(statsN, 0) > 0 and trn2 > 0
            d = int(math.round(100.0 * array.get(statsW, 0) / array.get(statsN, 0) - 100.0 * trw2 / trn2))
            edgeTxt := (d >= 0 ? "+" : "") + str.tostring(d) + " pts"
        table.cell(tb, 0, 5, "edge (1st vs raw)", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 5, edgeTxt, text_color = edgeTxt == "—" or str.contains(edgeTxt, "-") ? color.new(color.gray, 15) : color.new(color.green, 10), text_size = size.tiny)
        table.cell(tb, 2, 5, "", text_size = size.tiny)
        string distU = ""
        string distD = ""
        if upZi >= 0 and not na(atr)
            distU := " · " + str.tostring((upLvl - close) / atr, "#.#") + " ATR"
        if dnZi >= 0 and not na(atr)
            distD := " · " + str.tostring((close - dnLvl) / atr, "#.#") + " ATR"
        string upLvlTxt = "none"
        string upInfTxt = ""
        if upZi >= 0
            upLvlTxt := str.tostring(upLvl, format.mintick)
            upInfTxt := f_zoneLabel(upZi) + distU
        string dnLvlTxt = "none"
        string dnInfTxt = ""
        if dnZi >= 0
            dnLvlTxt := str.tostring(dnLvl, format.mintick)
            dnInfTxt := f_zoneLabel(dnZi) + distD
        string stopTxt = "—"
        string stopWhy = ""
        if nsZi >= 0
            stopTxt := (nsUp ? "↑ " : "↓ ") + str.tostring(nsLvl, format.mintick)
            string stopKind = "nearest zone"
            if array.get(zTouches, nsZi) == 0
                stopKind := "fresh magnet"
            stopWhy := stopKind
            if not na(atr)
                stopWhy := stopKind + " · " + str.tostring(math.abs(nsLvl - close) / atr, "#.#") + " ATR"
        if showRoadmapRows
            table.cell(tb, 0, 6, "road ↑", text_color = color.new(color.red, 15), text_size = size.tiny)
            table.cell(tb, 1, 6, upLvlTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
            table.cell(tb, 2, 6, upInfTxt, text_color = color.new(color.gray, 25), text_size = size.tiny)
            table.cell(tb, 0, 7, "road ↓", text_color = color.new(color.green, 15), text_size = size.tiny)
            table.cell(tb, 1, 7, dnLvlTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
            table.cell(tb, 2, 7, dnInfTxt, text_color = color.new(color.gray, 25), text_size = size.tiny)
            table.cell(tb, 0, 8, "NEXT STOP", text_color = color.new(color.white, 8), text_size = size.tiny, bgcolor = hdr)
            table.cell(tb, 1, 8, stopTxt, text_color = color.new(color.white, 8), text_size = size.tiny, bgcolor = hdr)
            table.cell(tb, 2, 8, stopWhy, text_color = color.new(color.white, 20), text_size = size.tiny, bgcolor = hdr)
        else
            table.cell(tb, 0, 6, "", text_size = size.tiny)
            table.cell(tb, 1, 6, "", text_size = size.tiny)
            table.cell(tb, 2, 6, "", text_size = size.tiny)
            table.cell(tb, 0, 7, "", text_size = size.tiny)
            table.cell(tb, 1, 7, "", text_size = size.tiny)
            table.cell(tb, 2, 7, "", text_size = size.tiny)
            table.cell(tb, 0, 8, "", text_size = size.tiny)
            table.cell(tb, 1, 8, "", text_size = size.tiny)
            table.cell(tb, 2, 8, "", text_size = size.tiny)
        // clock: best / worst / now
        int bestH = -1
        int worstH = -1
        for h = 0 to 23
            if array.get(hn, h) > 0
                if bestH < 0
                    bestH := h
                    worstH := h
                else
                    if 100.0 * array.get(hw, h) / array.get(hn, h) >= 100.0 * array.get(hw, bestH) / array.get(hn, bestH)
                        bestH := h
                    if 100.0 * array.get(hw, h) / array.get(hn, h) <= 100.0 * array.get(hw, worstH) / array.get(hn, worstH)
                        worstH := h
        string bestTxt = "—"
        string bestN = ""
        string worstTxt = "—"
        string worstN = ""
        if bestH >= 0
            bestTxt := (bestH < 10 ? "0" : "") + str.tostring(bestH) + ":00 · " + f_pct(array.get(hw, bestH), array.get(hn, bestH))
            bestN := "n=" + str.tostring(array.get(hn, bestH))
            if array.get(hn, bestH) < minSample
                bestN += " · low n"
        if worstH >= 0
            worstTxt := (worstH < 10 ? "0" : "") + str.tostring(worstH) + ":00 · " + f_pct(array.get(hw, worstH), array.get(hn, worstH))
            worstN := "n=" + str.tostring(array.get(hn, worstH))
            if array.get(hn, worstH) < minSample
                worstN += " · low n"
        table.cell(tb, 0, 9, "best hour", text_color = color.new(color.green, 10), text_size = size.tiny)
        table.cell(tb, 1, 9, bestTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 9, bestN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 10, "worst hour", text_color = color.new(color.red, 10), text_size = size.tiny)
        table.cell(tb, 1, 10, worstTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 10, worstN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 11, "now " + (hrU < 10 ? "0" : "") + str.tostring(hrU) + ":00", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 11, f_pct(array.get(hw, hrU), array.get(hn, hrU)), text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 11, "n=" + str.tostring(array.get(hn, hrU)) + f_lowN(array.get(hn, hrU)), text_color = color.new(color.gray, 30), text_size = size.tiny)
        // consensus
        string consTxt = "off"
        string consN = ""
        if useHTF
            consTxt := str.tostring(agree1) + " · " + str.tostring(agree4)
            consN := "zones w/ 1H · 4H tag"
        table.cell(tb, 0, 12, "consensus", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 12, consTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 12, consN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        // size
        string szTxt = "off"
        string szN = "enable in settings"
        if sizeOn
            if not na(szLots)
                szTxt := str.tostring(szLots, "#.##") + (centAcct ? " cent-lots" : " lots")
                szN := "risk $" + str.tostring(szRisk, "#.#") + " · " + sizeDir
            else
                szTxt := "—"
                szN := szMsg
        table.cell(tb, 0, 13, "size", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 13, szTxt, text_color = not sizeOn or na(szLots) ? color.new(color.gray, 20) : color.new(color.green, 10), text_size = size.tiny)
        table.cell(tb, 2, 13, szN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        string tpTxt = "—"
        string tpN = ""
        if sizeOn and not na(szTp1)
            tpTxt := str.tostring(szTp1, format.mintick) + " / " + str.tostring(szTp2, format.mintick)
            tpN := "TP1 0.75R · TP2 1.5R"
        table.cell(tb, 0, 14, "TP1 / TP2", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 14, tpTxt, text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 14, tpN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        // gauge
        string volTxt = "—"
        string volN = ""
        if gaugeOn and not na(atrPct)
            volTxt := volRegime
            volN := "ATR " + str.tostring(atrPct, "#") + "th pct"
            if volRegime == "WILD"
                volN += " · wider stops, smaller size"
            else if volRegime == "QUIET"
                volN += " · tight stops, expect chop"
        table.cell(tb, 0, 15, "volatility", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 15, volTxt, text_color = volTxt == "WILD" ? color.new(color.red, 10) : volTxt == "QUIET" ? color.new(color.gray, 10) : color.new(color.green, 10), text_size = size.tiny)
        table.cell(tb, 2, 15, volN, text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 16, "zones " + str.tostring(array.size(zTop)), text_color = color.new(color.gray, 35), text_size = size.tiny)
        table.cell(tb, 1, 16, "bounce " + str.tostring(bounceR, "#.##") + " ATR · " + str.tostring(evalWindow) + " bars", text_color = color.new(color.gray, 35), text_size = size.tiny)
        table.cell(tb, 2, 16, "excl " + str.tostring(exclN) + " · heat g60/r40", text_color = color.new(color.gray, 35), text_size = size.tiny)
        table.cell(tb, 0, 17, "signals fired", text_color = color.new(color.white, 25), text_size = size.tiny)
        table.cell(tb, 1, 17, str.tostring(sigAPlus) + " A+ · " + str.tostring(sigRevN) + " REV", text_color = color.new(color.white, 20), text_size = size.tiny)
        table.cell(tb, 2, 17, "desk 15m: A+ 80% s3 · REV 92%", text_color = color.new(color.gray, 30), text_size = size.tiny)
        table.cell(tb, 0, 18, "signals closed-bar · no repaint", text_color = color.new(color.gray, 45), text_size = size.tiny)
        table.cell(tb, 1, 18, "alerts: A+/REV L/S", text_color = color.new(color.gray, 45), text_size = size.tiny)
        table.cell(tb, 2, 18, "heat g60/r40", text_color = color.new(color.gray, 45), text_size = size.tiny)
