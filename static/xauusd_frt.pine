//@version=5
// ============================================================================
//  XAUUSD FRT  ·  ZONE HEALTH SCOUT  —  the desk's THIRD indicator
//
//  ONLY BOXES. No signals, no alerts, no dashboard, no noise.
//  Every institutional zone is scouted, labeled and health-tracked:
//     · FRESH  solid box, full color  — untested zone, full power
//     · TESTED dashed box, faded      — one retest absorbed
//     · WEAK   gray box               — consumed, break watch
//     · gone   box deleted            — the zone broke
//
//  NO REPAINT — GUARANTEED BY DESIGN:
//     · zones are born only from CONFIRMED pivots (k bars later), so a
//       box never appears at a bar earlier than its own confirmation
//     · top, bottom and left edge are FIXED at creation — a box never
//       moves, never resizes, never redraws
//     · state changes (FRESH → TESTED → WEAK) are evaluated on CLOSED
//       bars only (barstate.isconfirmed) — nothing flickers intrabar
//     · a broken or expired box is deleted, never resurrected
//
//  Use it to READ the market: trade fresh zones with your own strategy,
//  treat tested zones with caution, expect weak zones to break.
//  Pair with indicator № 1 (A+ SNIPER) and № 2 (FLOW) for the signals.
// ============================================================================
indicator("XAUUSD FRT [Zone Health Scout]", overlay = true,
     max_boxes_count = 500)

// ---- inputs ----------------------------------------------------------------
kSwing  = input.int(3,     "Swing strength (bars each side) — 3 = precise scout · 2 = more boxes", minval = 2, maxval = 10)
impAtr  = input.float(1.8, "Impulse: min ATR multiple",  minval = 0.5, step = 0.1)
zoneAtr = input.float(2.0, "Max zone height (ATR)",      minval = 0.5, step = 0.1)
slBuf   = input.float(0.15, "Break buffer beyond zone (ATR)", minval = 0.0, step = 0.05)
showSess = input.bool(true, "Shade dead session (21:00-01:00 UTC)")

// ---- basics -----------------------------------------------------------------
atr = ta.atr(14)
hr  = hour(time, "UTC")
sessDead = hr >= 21 or hr < 1
bgcolor(showSess and sessDead ? color.new(color.gray, 94) : na)

// ---- swings ------------------------------------------------------------------
ph = ta.pivothigh(high, kSwing, kSwing)
pl = ta.pivotlow(low,  kSwing, kSwing)

// unpaired swing storage (waiting for their opposing swing to confirm)
var loIdx = array.new_int(0)
var loVal = array.new_float(0)
var loAtr = array.new_float(0)
var loTop = array.new_float(0)
var loBot = array.new_float(0)
var loPriorHi = array.new_float(0)
var hiIdx = array.new_int(0)
var hiVal = array.new_float(0)
var hiAtr = array.new_float(0)
var hiTop = array.new_float(0)
var hiBot = array.new_float(0)
var hiPriorLo = array.new_float(0)

// newest confirmed swings (for prior-swing references)
var int   h1i = -1
var float h1v = na
var int   h2i = -1
var float h2v = na
var int   l1i = -1
var float l1v = na
var int   l2i = -1
var float l2v = na

// live zones (parallel arrays) — zTouches drives the health state
var zTop = array.new_float(0)
var zBot = array.new_float(0)
var zSide = array.new_int(0)        // +1 demand, -1 supply
var zTouches = array.new_int(0)     // 0 FRESH · 1 TESTED · 2+ WEAK
var zCreated = array.new_int(0)
var zBox = array.new_box(0)

// ---- pivot processing --------------------------------------------------------
if not na(ph) and bar_index > kSwing + 2
    pi = bar_index - kSwing
    h2i := h1i
    h2v := h1v
    h1i := pi
    h1v := ph
    bTop = math.max(high[kSwing], math.max(high[kSwing + 1], high[kSwing + 2]))
    bBot = math.min(low[kSwing],  math.min(low[kSwing + 1],  low[kSwing + 2]))
    array.push(hiIdx, pi)
    array.push(hiVal, ph)
    array.push(hiAtr, atr[kSwing])
    array.push(hiTop, bTop)
    array.push(hiBot, bBot)
    array.push(hiPriorLo, l1v)
    // pair every unpaired swing LOW with this, its first following high
    if array.size(loIdx) > 0
        for i = array.size(loIdx) - 1 to 0
            sIdx = array.get(loIdx, i)
            sVal = array.get(loVal, i)
            sAtr = array.get(loAtr, i)
            sTop = array.get(loTop, i)
            sBot = array.get(loBot, i)
            impulse = ph - sVal
            if pi - sIdx <= 48 and impulse >= impAtr * sAtr and sTop > sBot and sTop - sBot <= zoneAtr * sAtr
                dup = false
                if array.size(zTop) > 0
                    for zi = 0 to array.size(zTop) - 1
                        if array.get(zSide, zi) == 1 and bar_index - array.get(zCreated, zi) <= 24 and not (sBot > array.get(zTop, zi) or sTop < array.get(zBot, zi))
                            dup := true
                            break
                if not dup
                    array.push(zTop, sTop)
                    array.push(zBot, sBot)
                    array.push(zSide, 1)
                    array.push(zTouches, 0)
                    array.push(zCreated, bar_index)
                    array.push(zBox, box.new(sIdx, sTop, bar_index + 6, sBot, border_color = color.new(color.green, 30), bgcolor = color.new(color.green, 82), border_width = 1, text = "FRESH", text_color = color.new(color.green, 5), text_size = size.tiny))
            array.remove(loIdx, i)
            array.remove(loVal, i)
            array.remove(loAtr, i)
            array.remove(loTop, i)
            array.remove(loBot, i)
            array.remove(loPriorHi, i)

if not na(pl) and bar_index > kSwing + 2
    pi = bar_index - kSwing
    l2i := l1i
    l2v := l1v
    l1i := pi
    l1v := pl
    bTop = math.max(high[kSwing], math.max(high[kSwing + 1], high[kSwing + 2]))
    bBot = math.min(low[kSwing],  math.min(low[kSwing + 1],  low[kSwing + 2]))
    array.push(loIdx, pi)
    array.push(loVal, pl)
    array.push(loAtr, atr[kSwing])
    array.push(loTop, bTop)
    array.push(loBot, bBot)
    array.push(loPriorHi, h1v)
    // pair every unpaired swing HIGH with this, its first following low
    if array.size(hiIdx) > 0
        for i = array.size(hiIdx) - 1 to 0
            sIdx = array.get(hiIdx, i)
            sVal = array.get(hiVal, i)
            sAtr = array.get(hiAtr, i)
            sTop = array.get(hiTop, i)
            sBot = array.get(hiBot, i)
            impulse = sVal - pl
            if pi - sIdx <= 48 and impulse >= impAtr * sAtr and sTop > sBot and sTop - sBot <= zoneAtr * sAtr
                dup = false
                if array.size(zTop) > 0
                    for zi = 0 to array.size(zTop) - 1
                        if array.get(zSide, zi) == -1 and bar_index - array.get(zCreated, zi) <= 24 and not (sBot > array.get(zTop, zi) or sTop < array.get(zBot, zi))
                            dup := true
                            break
                if not dup
                    array.push(zTop, sTop)
                    array.push(zBot, sBot)
                    array.push(zSide, -1)
                    array.push(zTouches, 0)
                    array.push(zCreated, bar_index)
                    array.push(zBox, box.new(sIdx, sTop, bar_index + 6, sBot, border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 82), border_width = 1, text = "FRESH", text_color = color.new(color.red, 5), text_size = size.tiny))
            array.remove(hiIdx, i)
            array.remove(hiVal, i)
            array.remove(hiAtr, i)
            array.remove(hiTop, i)
            array.remove(hiBot, i)
            array.remove(hiPriorLo, i)

// ---- zone health engine — CLOSED BARS ONLY (strict no-repaint) ---------------
if barstate.isconfirmed and array.size(zTop) > 0
    for zi = array.size(zTop) - 1 to 0
        s = array.get(zSide, zi)
        zt = array.get(zTop, zi)
        zb = array.get(zBot, zi)
        old = bar_index - array.get(zCreated, zi)
        broken = s == 1 ? low < zb - slBuf * atr : high > zt + slBuf * atr
        if broken or old > 500
            box.delete(array.get(zBox, zi))
            array.remove(zTop, zi)
            array.remove(zBot, zi)
            array.remove(zSide, zi)
            array.remove(zTouches, zi)
            array.remove(zCreated, zi)
            array.remove(zBox, zi)
        else
            if not na(array.get(zBox, zi))
                box.set_right(array.get(zBox, zi), bar_index + 6)
            touching = s == 1 ? (low <= zt and close >= zb) : (high >= zb and close <= zt)
            if touching
                tN = array.get(zTouches, zi) + 1
                array.set(zTouches, zi, tN)
                bxh = array.get(zBox, zi)
                if not na(bxh)
                    zc = s == 1 ? color.green : color.red
                    if tN == 1
                        box.set_text(bxh, "TESTED")
                        box.set_text_color(bxh, color.new(zc, 25))
                        box.set_border_style(bxh, line.style_dashed)
                        box.set_bgcolor(bxh, color.new(zc, 92))
                    else
                        box.set_text(bxh, "WEAK")
                        box.set_text_color(bxh, color.new(color.gray, 15))
                        box.set_border_color(bxh, color.new(color.gray, 45))
                        box.set_bgcolor(bxh, color.new(zc, 95))

// ---- pruning of unpaired pivots ----------------------------------------------
if array.size(loIdx) > 0
    for i = array.size(loIdx) - 1 to 0
        if bar_index - array.get(loIdx, i) > 200
            array.remove(loIdx, i)
            array.remove(loVal, i)
            array.remove(loAtr, i)
            array.remove(loTop, i)
            array.remove(loBot, i)
            array.remove(loPriorHi, i)
if array.size(hiIdx) > 0
    for i = array.size(hiIdx) - 1 to 0
        if bar_index - array.get(hiIdx, i) > 200
            array.remove(hiIdx, i)
            array.remove(hiVal, i)
            array.remove(hiAtr, i)
            array.remove(hiTop, i)
            array.remove(hiBot, i)
            array.remove(hiPriorLo, i)
